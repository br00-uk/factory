{
  "repository": "/absolute/path/to/migratory",
  "baseRef": "main",
  "linear": {
    "organization": "neverzero",
    "team": "MIG"
  },
  "model": {
    "provider": "openai-codex",
    "id": "gpt-5.5",
    "authFile": "/absolute/path/to/.pi/agent/auth.json",
    "maxOutputTokens": 8192
  },
  "budgetUsd": null,
  "environment": {
    "checks": [
      {
        "name": "go-build",
        "argv": [
          "go",
          "build",
          "./..."
        ],
        "timeoutSeconds": 1200
      },
      {
        "name": "go-vet",
        "argv": [
          "go",
          "vet",
          "./..."
        ],
        "timeoutSeconds": 1200
      },
      {
        "name": "go-test-race",
        "argv": [
          "go",
          "test",
          "-race",
          "./..."
        ],
        "timeoutSeconds": 2400
      }
    ],
    "dependencies": {
      "argv": [
        "sh",
        "-c",
        "set -eu; go mod download"
      ],
      "timeoutSeconds": 1800,
      "allowHosts": [
        "proxy.golang.org",
        "sum.golang.org",
        "storage.googleapis.com"
      ],
      "paths": []
    },
    "env": {
      "GOFLAGS": "-buildvcs=false",
      "GOTOOLCHAIN": "local",
      "GOCACHE": "${FACTORY_CACHE}/go-build",
      "GOMODCACHE": "${FACTORY_CACHE}/go-mod",
      "GOPROXY": "https://proxy.golang.org",
      "GOSUMDB": "sum.golang.org",
      "CI": "true"
    }
  },
  "limits": {
    "stageSeconds": 2700,
    "commandSeconds": 1800,
    "maxOutputBytes": 1048576,
    "maxFileBytes": 2097152,
    "maxArtifactBytes": 33554432,
    "maxTurns": 30,
    "activeSeconds": 7200
  }
}
