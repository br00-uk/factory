#!/bin/sh
# Thin launcher: resolves symlinks back to the factory checkout and runs its CLI.
self="$0"
while [ -L "$self" ]; do
  dir=$(cd "$(dirname "$self")" && pwd)
  self=$(readlink "$self")
  case "$self" in /*) ;; *) self="$dir/$self" ;; esac
done
root=$(cd "$(dirname "$self")/.." && pwd)
exec node "$root/dist/src/cli.js" "$@"
