{
  "repository": "/absolute/path/to/salesbook",
  "baseRef": "main",
  "linear": {
    "organization": "neverzero",
    "project": {
      "name": "Salesbook",
      "url": "https://linear.app/neverzero/project/salesbook-fd9671bd1086/overview"
    }
  },
  "model": {
    "provider": "openai-codex",
    "id": "gpt-5.5",
    "authFile": "/absolute/path/to/.pi/agent/auth.json",
    "maxOutputTokens": 8192
  },
  "budgetUsd": null,
  "environment": {
    "checks": [
      {
        "name": "go-tests",
        "argv": [
          "go",
          "test",
          "./..."
        ],
        "timeoutSeconds": 600
      },
      {
        "name": "go-vet",
        "argv": [
          "go",
          "vet",
          "./..."
        ],
        "timeoutSeconds": 600
      },
      {
        "name": "web-tests",
        "argv": [
          "sh",
          "-c",
          "cd apps/web && npm run typecheck && npm test"
        ],
        "timeoutSeconds": 600
      }
    ],
    "dependencies": {
      "argv": [
        "sh",
        "-c",
        "set -eu; go mod download; cd apps/web; npm ci --ignore-scripts --no-audit --no-fund"
      ],
      "timeoutSeconds": 1800,
      "allowHosts": [
        "proxy.golang.org",
        "sum.golang.org",
        "storage.googleapis.com",
        "registry.npmjs.org"
      ],
      "paths": [
        "apps/web/node_modules"
      ]
    },
    "env": {
      "GOFLAGS": "-buildvcs=false",
      "GOTOOLCHAIN": "local",
      "GOCACHE": "${FACTORY_CACHE}/go-build",
      "GOMODCACHE": "${FACTORY_CACHE}/go-mod",
      "GOPROXY": "https://proxy.golang.org",
      "GOSUMDB": "sum.golang.org",
      "CI": "true",
      "NPM_CONFIG_CACHE": "${FACTORY_CACHE}/npm"
    }
  },
  "limits": {
    "stageSeconds": 2700,
    "commandSeconds": 1800,
    "maxOutputBytes": 1048576,
    "maxFileBytes": 2097152,
    "maxArtifactBytes": 33554432,
    "maxTurns": 30,
    "activeSeconds": 7200
  }
}
