{
  "name": "local-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local, human-gated software factory with OS-sandboxed agent sessions",
  "engines": {
    "node": ">=26.5.0 <27"
  },
  "bin": {
    "factory": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/prune-dist.mjs",
    "check": "npm run build --silent && node --test --test-concurrency=1 dist/tests/*.test.js",
    "factory": "node dist/src/cli.js"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.79",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "typebox": "1.3.27",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  }
}
