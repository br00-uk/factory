{
  "repository": "/absolute/path/to/repository",
  "baseRef": "main",
  "linear": {
    "organization": "your-organization",
    "team": "ENG"
  },
  "model": {
    "provider": "openai-codex",
    "id": "gpt-5.5",
    "authFile": "/absolute/path/to/.pi/agent/auth.json",
    "maxOutputTokens": 8192
  },
  "budgetUsd": null,
  "environment": {
    "checks": [
      {
        "name": "tests",
        "argv": [
          "python3",
          "-B",
          "-m",
          "unittest",
          "discover"
        ],
        "timeoutSeconds": 600
      }
    ]
  },
  "limits": {
    "stageSeconds": 1800,
    "commandSeconds": 600,
    "maxOutputBytes": 262144,
    "maxFileBytes": 2097152,
    "maxArtifactBytes": 33554432,
    "maxTurns": 30,
    "activeSeconds": 7200
  }
}
